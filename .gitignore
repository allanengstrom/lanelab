# you scrape or upload for a real league lands in the paths below and stays out.
time_trials/
manual_times/
roster/
roster_excludes/
meet_prefs/
leaders_cache*.json
team_codes.json
shb_absences.json
week_absences.json
top3_absences.json
data/

# Trained models (train your own: python3 train_coach_predictor.py)
*.pkl
